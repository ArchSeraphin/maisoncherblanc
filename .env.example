# ---------------------------------------------------------------------------
# Maison Cherblanc : variables d'environnement (copier en .env à la racine).
# .env est la source UNIQUE pour l'app ET les scripts (seed, create-admin...).
# Coolify : les mêmes variables dans l'interface (pas de .env dans l'image).
# Aucune variable NEXT_PUBLIC_* : tout est lu au runtime (changement = redémarrage).
# ---------------------------------------------------------------------------

# URL publique (canonical, sitemap, Open Graph), sans slash final.
SITE_URL=https://maisoncherblanc.fr

# Base SQLite et fichiers envoyés : HORS du dossier de déploiement en production
# (Docker/Coolify : /data/cherblanc.db et /data/uploads, déjà posés par le Dockerfile).
DATABASE_PATH=./data/cherblanc.db
UPLOADS_DIR=./data/uploads

# Secret de session (>= 32 caractères). Générer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Chemin secret du backoffice (un segment, 6 à 64 caractères a-z 0-9 -).
# Jamais admin/backoffice/login/dashboard. Changeable sans rebuild (redémarrage).
ADMIN_PATH=

# Premier administrateur, créé par `npm run seed` (jamais écrasé ensuite).
# ADMIN_NAME (facultatif) : prénom affiché dans le backoffice (« Bonjour Thierry »).
# Retirer ADMIN_PASSWORD une fois le seed fait.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# 1 derrière un reverse proxy (Traefik Coolify, nginx) : l'IP client est lue
# dans le DERNIER élément de X-Forwarded-For (freins de connexion, formulaire).
TRUST_PROXY=1

# Notification e-mail des messages du formulaire (API transactionnelle Brevo).
# Sans clé : aucun e-mail, les messages restent lisibles dans le backoffice.
# CONTACT_EMAIL : destinataire(s) séparés par des virgules ; MAIL_FROM : expéditeur validé dans Brevo.
BREVO_API_KEY=
CONTACT_EMAIL=contact@maisoncherblanc.fr
MAIL_FROM=

# 1 sur un domaine de préproduction : noindex partout, robots.txt Disallow: /
NOINDEX=

PORT=3000

# Uniquement pour tester `npm start` en HTTP local (cookie non Secure, pas de HSTS).
# COOKIE_SECURE=0
